# API keys for article full-text download (03_download_pdfs.Rmd)
# Copy this file to .Renviron and fill in your keys.
# .Renviron is gitignored and will not be committed.

# Elsevier ScienceDirect API key
# Register at: https://dev.elsevier.com/
ELSEVIER_API_KEY=

# Wiley TDM client token
# Apply at: https://onlinelibrary.wiley.com/library-info/resources/text-and-datamining
WILEY_TDM_TOKEN=
